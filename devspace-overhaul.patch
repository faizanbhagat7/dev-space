+  border-radius: var(--radius-md);
+  background: var(--surface);
+  border: 1.5px solid var(--border);
+  font-family: var(--font-body);
+  font-size: 14px;
+  color: var(--text-primary);
+  cursor: pointer;
+  transition: all var(--transition);
+  overflow-wrap: break-word;
+  word-break: break-word;
+  position: relative;
+}
+
+.question-option:hover:not(.option-selected):not(.option-correct):not(.option-wrong) {
+  border-color: var(--black);
+  background: var(--cream);
+  transform: translateX(3px);
+}
+
+.option-correct {
+  background: rgba(34,197,94,0.1) !important;
+  border-color: var(--green-code) !important;
+  color: var(--green-code) !important;
+}
+
+.option-wrong {
+  background: rgba(232,18,124,0.08) !important;
+  border-color: var(--magenta) !important;
+  color: var(--magenta) !important;
+}
+
+.option-selected {
+  background: rgba(10,10,10,0.06) !important;
+  border-color: var(--black) !important;
+}
+
+.question-next {
+  display: flex;
+  gap: 10px;
+  justify-content: flex-end;
+  padding-top: 4px;
+}
+
+.question-next-button {
+  padding: 10px 24px;
+  background: var(--black);
+  color: var(--cream);
+  border-radius: var(--radius-md);
+  font-family: var(--font-mono);
+  font-size: 12px;
+  font-weight: 700;
+  cursor: pointer;
+  border: none;
+  transition: all var(--transition-bounce);
+}
+
+.question-next-button:hover {
+  background: var(--magenta);
+  transform: translateY(-2px);
+  box-shadow: var(--shadow-magenta);
+}
+
+.question-next-button:disabled {
+  opacity: 0.35;
+  cursor: not-allowed;
+  transform: none;
+}
+
+.quit-test-button {
+  padding: 10px 18px;
+  background: transparent;
+  color: var(--text-muted);
+  border-radius: var(--radius-md);
+  font-family: var(--font-mono);
+  font-size: 12px;
+  cursor: pointer;
+  border: 1.5px solid var(--border-strong);
+  transition: all var(--transition);
+}
+
+.quit-test-button:hover {
+  border-color: var(--text-primary);
+  color: var(--text-primary);
+}
+
+@media (max-width: 768px) {
+  .question-text > p { font-size: 14px; }
+  .question-option { font-size: 13px; }
+}
