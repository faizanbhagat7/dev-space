+/* ===== AUTH PAGES ===== */
+.main-body {
+  width: 100vw;
+  height: 100vh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--black);
+  position: relative;
+  overflow: hidden;
+}
+
+/* Animated code grid background */
+.main-body::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background-image:
+    linear-gradient(rgba(232,18,124,0.04) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(232,18,124,0.04) 1px, transparent 1px);
+  background-size: 48px 48px;
+  animation: gridDrift 20s linear infinite;
+}
+
+@keyframes gridDrift {
+  from { transform: translate(0,0); }
+  to { transform: translate(48px, 48px); }
+}
+
+/* Corner accent */
+.main-body::after {
+  content: '{ dev_space }';
+  position: absolute;
+  top: 32px;
+  left: 40px;
+  font-family: var(--font-mono);
+  font-size: 13px;
+  color: var(--magenta);
+  opacity: 0.6;
+  letter-spacing: 0.05em;
+}
+
+.container {
+  background: var(--surface);
+  border-radius: var(--radius-xl);
+  box-shadow: 0 24px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06);
+  display: flex;
+  width: 780px;
+  max-width: 95vw;
+  overflow: hidden;
+  animation: popIn 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
+  position: relative;
+  z-index: 1;
+}
+
+/* Left banner */
+.banner-section {
+  width: 45%;
+  background: var(--black-soft);
+  padding: 48px 36px;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  position: relative;
+  overflow: hidden;
+  flex-shrink: 0;
+}
+
+.banner-section::before {
+  content: '';
+  position: absolute;
+  top: -40px;
+  right: -40px;
+  width: 200px;
+  height: 200px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(232,18,124,0.3), transparent 70%);
+  pointer-events: none;
+}
+
+.banner-section::after {
+  content: '';
+  position: absolute;
+  bottom: -60px;
+  left: -60px;
+  width: 240px;
+  height: 240px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(0,200,200,0.12), transparent 70%);
+  pointer-events: none;
+}
+
+.banner-logo {
+  font-family: var(--font-display);
+  font-size: 32px;
+  font-weight: 800;
+  color: var(--cream);
+  line-height: 1;
+  margin-bottom: 12px;
+}
+
+.banner-logo span { color: var(--magenta); }
+
+.tagline {
+  font-family: var(--font-mono);
+  font-size: 11px;
+  color: rgba(245,240,232,0.5);
+  letter-spacing: 0.05em;
+  line-height: 1.7;
+}
+
+.banner-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-top: 32px;
+}
+
+.banner-tag {
+  font-family: var(--font-mono);
+  font-size: 10px;
+  background: rgba(232,18,124,0.12);
+  color: var(--magenta-light);
+  border: 1px solid rgba(232,18,124,0.25);
+  padding: 4px 10px;
+  border-radius: 99px;
+}
+
+/* Right form */
+.form-section {
+  flex: 1;
+  padding: 48px 40px;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+}
+
+.form-title {
+  font-family: var(--font-display);
+  font-size: 24px;
+  font-weight: 800;
+  color: var(--text-primary);
+  margin-bottom: 28px;
+}
+
+.input-label {
+  font-family: var(--font-mono);
+  font-size: 11px;
+  font-weight: 700;
+  color: var(--text-muted);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  margin-bottom: 6px;
+  display: block;
+}
+
+.input-field {
+  width: 100%;
+  padding: 11px 14px;
+  border: 1.5px solid var(--border-strong);
+  border-radius: var(--radius-md);
+  background: var(--cream);
+  font-family: var(--font-body);
+  font-size: 14px;
+  color: var(--text-primary);
+  outline: none;
+  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
+  margin-bottom: 18px;
+  display: block;
+}
+
+.input-field:focus {
+  border-color: var(--magenta);
+  box-shadow: 0 0 0 3px rgba(232,18,124,0.12);
+  transform: none;
 }
 
